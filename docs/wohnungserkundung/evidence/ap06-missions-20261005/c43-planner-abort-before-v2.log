monkeypatch = <_pytest.monkeypatch.MonkeyPatch object at 0x7fcb2703bcd0>
alternate = True

    @pytest.mark.parametrize('alternate', [True, False])
    def test_abort_without_motion_keeps_alternatives_and_original_attempt_cap(monkeypatch, alternate):
        node, grid, clock, parent, terminal = parent_fixture(monkeypatch, 'open')
        # Two disconnected frontier clusters give target poses outside the
        # rejected .6-m neighbourhood; any shared task ID retains its try cap.
        for row in range(18, 23):
            for col in range(25, grid.info.width):
                grid.data[row*grid.info.width+col] = 0
        grid.header.stamp.nanosec = 20_000_000
        node._on_map(grid)
        node._on_metric_map_status(status(grid, accepted=3, observed=3, when=100.02))
        node._max_frontier_goals = 2
        node._max_failed_goals = 1
        node._prealign_to_goal = lambda *_args, **_kwargs: ('skipped',)
        requests, dispatched = [], []
        def planner(target, stopped):
            requests.append(target)
            assert not stopped()
            if len(requests) == 1 or not alternate:
                return None, 'nav2_plan_aborted'
            path = Path(); path.header.frame_id = 'map'
            for x, y in target.route:
                pose = PoseStamped(); pose.pose.position.x = x; pose.pose.position.y = y
                pose.pose.orientation.z = math.sin(target.yaw/2)
                pose.pose.orientation.w = math.cos(target.yaw/2)
                path.poses.append(pose)
            return path, None
        node._metric_request_nav_plan = planner
        def navigate(*_args, **_kwargs):
            target = requests[-1]; dispatched.append(target); clock[0] += .1
            newer = copy.deepcopy(grid)
            for xy in target.observation_points:
                col, row = node._world_to_grid(*xy, newer.info)
                newer.data[row*newer.info.width+col] = 0
            newer.header.stamp.nanosec = int((clock[0]-10)*1e9)
            node._on_map(newer)
            node._on_metric_map_status(status(newer, accepted=4, observed=4, when=100+clock[0]-10))
            node._robot_pose_sample = lambda: ((target.x, target.y, target.yaw), 0.)
            return 'success'
        node._navigate_to = navigate
        result = node._execute_metric_frontier(parent, 10., .3)
        assert not result.success and terminal == ['abort']  # original cap, no false completion
