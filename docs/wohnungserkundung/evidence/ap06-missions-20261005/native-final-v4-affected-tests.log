            origin_x_m=grid.info.origin.position.x, origin_y_m=grid.info.origin.position.y,
            origin_yaw_rad=math.atan2(2*(q.w*q.z+q.x*q.y),1-2*(q.y*q.y+q.z*q.z)),
            maximum_cells=self._wohnungserkundung_evidence_max_cells)
        live_view = False
