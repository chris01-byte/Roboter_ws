# Herstellertreiber fuer den STL-27L, bewusst auf einen Commit gepinnt.
# Der Vendor-Code bleibt ausserhalb dieses Repositorys. Die enge Amadeus-
# Korrektur fuer den seriellen Shutdown wird reproduzierbar als Patch gebaut.
#
# Aufbau (ausserhalb des Roboter-Workspace, damit der Normalbetrieb
# unberuehrt bleibt):
#   bash tools/kartierung/build_ldlidar_stl27l_overlay.sh
repositories:
  ldlidar_stl_ros2:
    type: git
    url: https://github.com/ldrobotSensorTeam/ldlidar_stl_ros2.git
    version: bf668a89baf722a787dadc442860dcbf33a82f5a
