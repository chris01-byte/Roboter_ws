<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- ===================================================================== -->
<!--  mission_manager (WP-4)                                                -->
<!--  Sichere Zwischenschicht zwischen Smartphone-GUI und Robotik-Logik.    -->
<!--  Nimmt JSON-Auftraege entgegen und startet spaeter den passenden BT.    -->
<!-- ===================================================================== -->
<package format="3">
  <name>mission_manager</name>
  <version>0.1.0</version>
  <description>WP-4 Mission Manager fuer Smartphone-GUI und Behavior-Tree-Auftraege.</description>
  <maintainer email="qtg0900@example.com">QTG0900</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>action_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>robot_interfaces</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
