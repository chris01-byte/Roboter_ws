<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- ===================================================================== -->
<!--  explore  -  Autonome Frontier-Exploration (WP-5, Ebene 1)             -->
<!--  ====================================================   -->
<!--  Faehrt selbststaendig die unbekannten Bereiche der Wohnung an, bis    -->
<!--  die Karte vollstaendig ist. Deterministisch und zielgerichtet,       -->
<!--  KEIN Zufallsgenerator. CPU-only (kein CUDA/LLM noetig).               -->
<!--                                                                        -->
<!--  Rolle in der Schichten-Architektur:                                   -->
<!--    mission_manager/BT  ->  explore_node (Action ExploreArea)           -->
<!--                        ->  Nav2 (navigate_to_pose)                     -->
<!-- ===================================================================== -->
<package format="3">
  <name>explore</name>
  <version>0.1.0</version>
  <description>Autonome Frontier-basierte Wohnungs-Erkundung ueber Nav2 (WP-5 Ebene 1).</description>
  <maintainer email="qtg0900@example.com">QTG0900</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>robot_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
