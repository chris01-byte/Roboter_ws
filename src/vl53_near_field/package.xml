<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- ===================================================================== -->
<!--  vl53_near_field (WP-1b)                                               -->
<!--  VL53L7CX-Nahbereich-Hinderniserkennung (2 Sensoren via TCA9548A)      -->
<!--  als ROS-2-Node. Faithful Port des getesteten Skripts + PointCloud2.   -->
<!-- ===================================================================== -->
<package format="3">
  <name>vl53_near_field</name>
  <version>0.1.0</version>
  <description>VL53L7CX Nahbereich-Hinderniserkennung als ROS-2-Node (WP-1b).</description>
  <maintainer email="qtg0900@example.com">QTG0900</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>robot_interfaces</depend>

  <!-- numpy via rosdep; smbus2 und vl53l5cx/vl53l7cx via pip installieren:
       pip install smbus2 vl53l5cx   (bzw. vl53l7cx) -->
  <exec_depend>python3-numpy</exec_depend>

  <!-- Fuer die reaktive Zone wird zur Laufzeit nav2_collision_monitor genutzt -->
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
