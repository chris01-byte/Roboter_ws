<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- ===================================================================== -->
<!--  robot_interfaces                                                      -->
<!--  Eigene ROS-2-Schnittstellen (msg/srv/action) fuer den mobilen         -->
<!--  Pick-and-Place-Roboter. Wird von bt_orchestrator (WP-2) benoetigt.    -->
<!-- ===================================================================== -->
<package format="3">
  <name>robot_interfaces</name>
  <version>0.1.0</version>
  <description>Eigene msg/srv/action-Schnittstellen fuer den mobilen Pick-and-Place-Roboter.</description>
  <maintainer email="qtg0900@example.com">QTG0900</maintainer>
  <license>MIT</license>

  <!-- Buildwerkzeuge: ament_cmake + IDL-Generator (erzeugt C++/Python aus den .msg/.srv/.action) -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Abhaengige Standard-Pakete, deren Typen wir in unseren Schnittstellen verwenden -->
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>action_msgs</depend>

  <!-- Laufzeit der generierten Schnittstellen -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Markiert dieses Paket als Schnittstellen-Paket -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
