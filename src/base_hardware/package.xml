<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- ===================================================================== -->
<!--  base_hardware                                                         -->
<!--  Erster echter Unterbau fuer den Differentialantrieb der Plattform.    -->
<!--  v1: Dry-run + optional RS485/Modbus-Ausgabe fuer aufgebockten Test.   -->
<!-- ===================================================================== -->
<package format="3">
  <name>base_hardware</name>
  <version>0.1.0</version>
  <description>Basis-Hardware-Node fuer Differentialantrieb mit Dry-run und optionaler RS485/Modbus-Ausgabe.</description>
  <maintainer email="qtg0900@example.com">QTG0900</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>python3-pip</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
