<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- ===================================================================== -->
<!--  robot_bringup  -  Onboard/Offboard-Deployment (WP-5 Baustein D)       -->
<!--  ====================================================   -->
<!--  Trennt den mobilen Roboter (ONBOARD, Echtzeit + Sicherheit) vom       -->
<!--  stationaeren KI-Server (OFFBOARD). Beide reden per ROS 2 DDS ueber    -->
<!--  WLAN (gleiche ROS_DOMAIN_ID). Enthaelt link_monitor, der die          -->
<!--  Erreichbarkeit des Servers ueberwacht (WLAN-Ausfall-Fallback).        -->
<!-- ===================================================================== -->
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>Start- und Netzwerk-Orchestrierung: Onboard-Roboter vs. Offboard-KI-Server (ROS 2 DDS), inkl. link_monitor.</description>
  <maintainer email="qtg0900@example.com">QTG0900</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- ONBOARD-Pakete, die robot.launch.py startet -->
  <exec_depend>safety_monitor</exec_depend>
  <exec_depend>base_hardware</exec_depend>
  <exec_depend>robot_map_manager</exec_depend>
  <exec_depend>semantic_map_manager</exec_depend>
  <exec_depend>vl53_near_field</exec_depend>
  <exec_depend>explore</exec_depend>
  <exec_depend>mission_manager</exec_depend>
  <exec_depend>bt_orchestrator</exec_depend>
  <exec_depend>robot_face</exec_depend>
  <exec_depend>smartphone_gui</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>robot_navigation</exec_depend>

  <!-- OFFBOARD-Pakete, die server.launch.py startet -->
  <exec_depend>llm_planner</exec_depend>
  <exec_depend>semantic_perception</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
