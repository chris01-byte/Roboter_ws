<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- ===================================================================== -->
<!--  smartphone_gui (WP-4)                                                 -->
<!--  Mobile Web-App/PWA fuer Raum-, Objekt- und Ablage-Auftraege.          -->
<!--  Kommuniziert via rosbridge WebSocket mit mission_manager.             -->
<!-- ===================================================================== -->
<package format="3">
  <name>smartphone_gui</name>
  <version>0.1.0</version>
  <description>WP-4 Smartphone GUI/PWA fuer den mobilen Pick-and-Place-Roboter.</description>
  <maintainer email="qtg0900@example.com">QTG0900</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mission_manager</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
