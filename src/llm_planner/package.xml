<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- ===================================================================== -->
<!--  llm_planner  -  Sprach-/Aufgabenplaner (WP-5 Baustein C, OFFBOARD)    -->
<!--  ====================================================   -->
<!--  Uebersetzt natuerliche Sprache in einen Missionsauftrag im           -->
<!--  bestehenden command_json-Format des mission_manager. Laeuft auf dem   -->
<!--  KI-Server (RTX 3090) und nutzt ein lokales LLM ueber Ollama.          -->
<!--  ASYNCHRON/High-Level - NIE im Echtzeit-Regelkreis.                    -->
<!-- ===================================================================== -->
<package format="3">
  <name>llm_planner</name>
  <version>0.1.0</version>
  <description>LLM-basierter Aufgabenplaner: natuerliche Sprache -> mission_manager command_json (WP-5 Baustein C).</description>
  <maintainer email="qtg0900@example.com">QTG0900</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-requests</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
